/// Bronze-to-Silver data quality run: one row per entity per pipeline run, with record counts and the DQ score.
table DQRun
	sourceLineageTag: [dq].[run]

	column DQRunID
		dataType: string
		isHidden
		sourceLineageTag: DQRunID
		summarizeBy: none
		sourceColumn: DQRunID

	column PipelineRunID
		dataType: string
		sourceLineageTag: PipelineRunID
		summarizeBy: none
		sourceColumn: PipelineRunID

	column EntityName
		dataType: string
		sourceLineageTag: EntityName
		summarizeBy: none
		sourceColumn: EntityName

	column StartTime
		dataType: dateTime
		formatString: General Date
		sourceLineageTag: StartTime
		summarizeBy: none
		sourceColumn: StartTime

	column EndTime
		dataType: dateTime
		formatString: General Date
		sourceLineageTag: EndTime
		summarizeBy: none
		sourceColumn: EndTime

	column TotalRecords
		dataType: int64
		formatString: 0
		sourceLineageTag: TotalRecords
		summarizeBy: none
		sourceColumn: TotalRecords

	column ValidRecords
		dataType: int64
		formatString: 0
		sourceLineageTag: ValidRecords
		summarizeBy: none
		sourceColumn: ValidRecords

	column RejectedRecords
		dataType: int64
		formatString: 0
		sourceLineageTag: RejectedRecords
		summarizeBy: none
		sourceColumn: RejectedRecords

	column DQScore
		dataType: double
		formatString: #,##0.00
		sourceLineageTag: DQScore
		summarizeBy: none
		sourceColumn: DQScore

	column Status
		dataType: string
		sourceLineageTag: Status
		summarizeBy: none
		sourceColumn: Status

	partition DQRun = entity
		mode: directLake
		source
			entityName: run
			schemaName: dq
			expressionSource: 'DirectLake - HP_02_LH_Health_Silver'
