                    "type": "Query",
                    "text": {
                      "value": "INSERT INTO etl.PipelineRun\n(\n    RunID,\n    PipelineName,\n    EntityName,\n    StartTime,\n    EndTime,\n    Status,\n    RowsRead,\n    RowsWritten,\n    RowsRejected,\n    DurationSeconds,\n    ErrorMessage,\n    BatchID\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    'HP_05_PL_Health_Master',\n    '@{item().SourceEntity}',\n    '@{pipeline().TriggerTime}',\n    '@{utcNow()}',\n    'SUCCESS',\n\n    @{coalesce(\n        json(\n            coalesce(\n                activity('Notebook_MetadataIngestion').output.result.exitValue,\n                '{\"RowsRead\":0,\"RowsWritten\":0,\"RowsRejected\":0}'\n            )\n        ).RowsRead,\n        0\n    )},\n\n    @{coalesce(\n        json(\n            coalesce(\n                activity('Notebook_MetadataIngestion').output.result.exitValue,\n                '{\"RowsRead\":0,\"RowsWritten\":0,\"RowsRejected\":0}'\n            )\n        ).RowsWritten,\n        0\n    )},\n\n    @{coalesce(\n        json(\n            coalesce(\n                activity('Notebook_MetadataIngestion').output.result.exitValue,\n                '{\"RowsRead\":0,\"RowsWritten\":0,\"RowsRejected\":0}'\n            )\n        ).RowsRejected,\n        0\n    )},\n\n    DATEDIFF(\n        SECOND,\n        '@{pipeline().TriggerTime}',\n        '@{utcNow()}'\n    ),\n\n    NULL,\n\n    '@{pipeline().RunId}'\n);",
                      "type": "Expression"
                    }
                  }
