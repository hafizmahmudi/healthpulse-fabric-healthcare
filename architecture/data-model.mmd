    DimDate {
        int DateKey PK
        date FullDate
        int YearNumber
        int MonthNumber
        string MonthName
        string QuarterName
        string DayName
        bit IsWeekend
    }
    DimPatient {
        bigint PatientKey PK
        string PatientID UK
        string Gender
        string Race
        string Ethnicity
        int Age
        string AgeGroup
        string MaritalStatus "SCD2 tracked"
        datetime ValidFrom
        datetime ValidTo
        bit IsCurrent
    }
    DimFacility {
        bigint FacilityKey PK
        string FacilityID UK
        string FacilityName
        string City
        string State
        decimal Revenue
        datetime ValidFrom
        datetime ValidTo
        bit IsCurrent
    }
    DimProvider {
        bigint ProviderKey PK
        string ProviderID UK
        string FacilityID FK
        string Specialty
        datetime ValidFrom
        datetime ValidTo
        bit IsCurrent
    }
    DimPayer {
        bigint PayerKey PK
        string PayerID UK
        string PayerName
        string Ownership
        datetime ValidFrom
        datetime ValidTo
        bit IsCurrent
    }
    DimDiagnosis {
        bigint DiagnosisKey PK
        string DiagnosisCode UK
        string DiagnosisDescription
    }
    DimMedication {
        bigint MedicationKey PK
        string MedicationCode UK
        string MedicationDescription
    }
    DimProcedure {
        bigint ProcedureKey PK
        string ProcedureCode UK
        string ProcedureDescription
    }
    FactEncounter {
        bigint EncounterKey PK
        string EncounterID UK
